elType": "container"}, {"id": "a3726ac", "settings": {"editor": "<p>Cuando la finalidad est\u00e1 vinculada a una oportunidad de compra, reforma o reposicionamiento, el an\u00e1lisis puede conectarse con soluciones de <a href=\"https://proactivofinance.com/prestamos-para-inversion-inmobiliaria-en-madrid/\"><strong>pr\u00e9stamos para inversi\u00f3n inmobiliaria en Madrid</strong></a>, siempre con condiciones adaptadas al activo y a la salida prevista.</p>", "paragraph_spacing": {"unit": "px", "size": 36, "sizes": []}, "text_color": "#FFF6F6", "link_color": "#FFF6F6", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "_padding": {"unit": "px", "top": "20", "right": "0", "bottom": "0", "left": "0", "isLinked": false}, "__globals__": {"link_color": "", "link_hover_color": "globals/colors?id=secondary"}, "align": "left", "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 50}, "_id": "296dc47"}, {"eael_vto_writing_gradient_color": "#FF6464", "eael_vto_writing_gradient_color_location": {"unit": "%", "size": 90}, "_id": "181ff74"}]}, "elements": [], "isInner": false, "widgetType": "text-editor", "elType": "widget"}], "isInner": true, "elType": "container"}, {"id": "ee39868", "settings": {"content_width": "full", "margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "padding": {"unit": "px", "top": "40", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "c19db26", "settings": {"title": "ProActivo Finance: capital privado para actuar a tiempo", "align": "center", "typography_typography": "custom", "title_color": "#FFFFFF", "_margin": {"unit": "px", "top": "20", "right": "0", "bottom": "020", "left": "0", "isLinked": false}, "eael_vto_writing_gradient_color_repeater": [{"eael_vto_writing_gradient_color": "#7C62FF", "eael_vto_writing_gradient_colo