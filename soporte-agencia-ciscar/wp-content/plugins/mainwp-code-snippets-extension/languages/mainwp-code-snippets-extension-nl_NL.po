#: js/mainwp-codesnippets.js:32
msgid "Are you sure you want to execute this code snippet?"
msgstr "Weet je zeker dat je dit codefragment wilt uitvoeren?"

#: js/mainwp-codesnippets.js:44 js/mainwp-codesnippets.js:116
msgid "Snippet title is required. Please, enter the title and try again."
msgstr "De snippertitel is vereist. Voer de titel in en probeer het opnieuw."

#: js/mainwp-codesnippets.js:53 js/mainwp-codesnippets.js:122
#: js/mainwp-codesnippets.js:279
msgid "Snippet cannot be empty. Please, enter the snippet and try again."
msgstr ""
"Knipsel kan niet leeg zijn. Voer het knipsel in en probeer het opnieuw."

#: js/mainwp-codesnippets.js:90
msgid "Checking if snippet already exists on child sites. Please wait..."
msgstr "Controleren of knipsel al bestaat op kindersites. Even geduld..."

#: js/mainwp-codesnippets.js:96
msgid "No selected sites. Please select wanted child sites first."
msgstr "Geen geselecteerde sites. Selecteer eerst de gewenste kinderlocaties."

#: js/mainwp-codesnippets.js:131
msgid "Saving snippet. Please wait..."
msgstr "Knipsel wordt opgeslagen. Even geduld..."

#: js/mainwp-codesnippets.js:150 js/mainwp-codesnippets.js:185
msgid "Are you sure you want to delete this code snippet?"
msgstr "Weet je zeker dat je dit codefragment wilt verwijderen?"

#: js/mainwp-codesnippets.js:158 js/mainwp-codesnippets.js:203
msgid " Deleting. Please wait..."
msgstr " Verwijderen. Even geduld..."

#: js/mainwp-codesnippets.js:165 js/mainwp-codesnippets.js:208
msgid "Snippet could not be deleted. Please, reload the page and try again."
msgstr ""
"Knipsel kon niet worden verwijderd. Laad de pagina opnieuw en probeer het "
"opnieuw."

#: js/mainwp-codesnippets.js:232
msgid "Deleting. Please wait..."
msgstr "Verwijderen. Even geduld..."

#: js/mainwp-codesnippets.js:237
msgid "Snippet deleted successfully."
msgstr "Knipsel succesvol verwijderd."

#: js/mainwp-codesnippets.js:270
msgid "Please select wanted child sites first!"
msgstr "Selecteer eerst de gewenste sites voor kinderen!"

#: js/mainwp-codesnippets.js:296
msgid "Executing the snippet on selected sites. Please wait..."
msgstr ""
"Het knipsel wordt uitgevoerd op geselecteerde sites. Even geduld "
"alstublieft..."

#: js/mainwp-codesnippets.js:351
msgid "Saving the snippet. Please wait..."
msgstr "Het knipsel wordt opgeslagen. Even geduld alstublieft..."

#: js/mainwp-codesnippets.js:387
msgid "Saved successfully!"
msgstr "Selectie succesvol opgeslagen!"

#: js/mainwp-codesnippets.js:394
msgid "Saving the snippet on selected sites. Please wait..."
msgstr "Het knipsel wordt opgeslagen op geselecteerde sites. Even geduld..."

#: js/mainwp-codesnippets.js:400
msgid "No selected sites to proceed. Process completed."
msgstr "Geen locaties geselecteerd om door te gaan. Proces voltooid."

#: js/mainwp-codesnippets.js:405
msgid "Snippet saved successfully!"
msgstr "Knipsel succesvol opgeslagen!"

#: js/mainwp-codesnippets.js:409
msgid "Saving process failed."
msgstr "Opslaan mislukt."

#: js/mainwp-codesnippets.js:452 js/mainwp-codesnippets.js:496
msgid "Undefined error occurred. Please, try again."
msgstr ""
"Er heeft zich een ongedefinieerde fout voorgedaan. Probeer het opnieuw."

#: js/mainwp-codesnippets.js:454 js/mainwp-codesnippets.js:498
msgid "Snippet cannot be empty."
msgstr "Knipsel kan niet leeg zijn."

#: js/mainwp-codesnippets.js:461 js/mainwp-codesnippets.js:505
msgid "Process failed. Please, try again."
msgstr "Proces mislukt. Probeer het opnieuw."

#: js/mainwp-codesnippets.js:472
msgid "Process completed successfully."
msgstr "Proces succesvol afgerond."

#: js/mainwp-codesnippets.js:511
msgid "Snipped saved successfully!"
msgstr "Knip succesvol opgeslagen!"

#: js/mainwp-codesnippets.js:565 js/mainwp-codesnippets.js:609
msgid "Undefined error occured. Please, try again."
msgstr "Er is een ongedefinieerde fout opgetreden. Probeer het opnieuw."

#: js/mainwp-codesnippets.js:572 js/mainwp-codesnippets.js:616
msgid "Saved without changes."
msgstr "Opgeslagen zonder wijzigingen."

#: js/mainwp-codesnippets.js:631
msgid "Process finished successfully."
msgstr "Proces succesvol afgerond."

#: js/mainwp-codesnippets.js:634
msgid "Process finished with errors"
msgstr "Proces beëindigd met fouten"

#: mainwp-code-snippets-extension.php:173
msgid ""
"requires <a href=\"https://mainwp.com/\" target=\"_blank\">MainWP Dashboard "
"Plugin</a> to be activated in order to work. Please install and activate <a "
"href=\"https://mainwp.com/\" target=\"_blank\">MainWP Dashboard Plugin</a> "
"first."
msgstr ""
"vereist dat de <a href=\"https://mainwp.com/\" target=\"_blank\">MainWP "
"Dashboard Plugin</a> geactiveerd is om te kunnen werken. Installeer en "
"activeer eerst de <a href=\"https://mainwp.com/\" target=\"_blank\">MainWP "
"Dashboard Plugin</a>."

#. Plugin Name of the plugin/theme
msgid "MainWP Code Snippets Extension"
msgstr "MainWP Code Snippets Uitbreiding"

#. Plugin URI of the plugin/theme
#. Author URI of the plugin/theme
msgid "https://mainwp.com"
msgstr "https://mainwp.com"

#. Description of the plugin/theme
msgid ""
"The MainWP Code Snippets Extension is a powerful PHP platform that enables "
"you to execute php code and scripts on your child sites and view the output "
"on your Dashboard. Requires the MainWP Dashboard plugin."
msgstr ""
"De MainWP Code Snippets Extension is een krachtig PHP-platform waarmee je "
"php-code en scripts kunt uitvoeren op je kindersites en de uitvoer kunt "
"bekijken op je Dashboard. Vereist de MainWP Dashboard-plugin."

#. Author of the plugin/theme
msgid "MainWP"
msgstr "MainWP"
